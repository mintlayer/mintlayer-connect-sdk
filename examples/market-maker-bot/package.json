{
  "name": "market-maker-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && node scripts/build.mjs && vite build",
    "build:server": "tsc --noEmit -p tsconfig.server.json && node scripts/build.mjs",
    "start": "node dist-server/main.cjs",
    "start:service": "node scripts/service.mjs",
    "test": "node scripts/test.mjs",
    "backup": "node dist-server/backup.cjs",
    "preview": "vite preview",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@mintlayer/sdk": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.1",
    "@fastify/static": "^8.3.0",
    "dotenv": "^17.2.3",
    "@mintlayer/wasm-lib": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "esbuild": "^0.28.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
