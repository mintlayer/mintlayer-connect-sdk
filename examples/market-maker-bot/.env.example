# Server settings. No wallet or API credentials are exposed to the frontend.
BOT_NETWORK=testnet
BOT_API_URL=https://api-server-lovelace.mintlayer.org/api/v2
BOT_API_KEY=
BOT_WALLET_SEED=

# Optional node on the SAME chain as BOT_API_URL. Enables mempool inspection
# and spending accepted unconfirmed change. Without it, wait for confirmations.
BOT_RPC_URL=
BOT_RPC_USER=
BOT_RPC_PASSWORD=

BOT_DB_PATH=data/bot.sqlite
BOT_HOST=127.0.0.1
BOT_PORT=3001
# Required when binding beyond loopback. Set BOT_COOKIE_SECURE=true behind HTTPS.
BOT_ADMIN_PASSWORD=
BOT_COOKIE_SECURE=false
BOT_AUTO_RESUME=false
BOT_LOG_LEVEL=info
BOT_EVENT_RETENTION_DAYS=14
BOT_REQUEST_TIMEOUT_MS=10000
BOT_STALE_AFTER_MS=60000
BOT_MAX_PENDING=24
# Rolling 24-hour fee budget and maximum fee per transaction, in ML/TML.
BOT_DAILY_FEE_LIMIT=100
BOT_MAX_TX_FEE=2

# Applied on first creation of the DB. Later edits use Strategy config in UI.
BOT_PAIR=HUG/TML
BOT_BASE_TOKEN=replace_with_actual_token_id
BOT_QUOTE_TOKEN=Coin
BOT_ORDER_SIZE=0.01
BOT_REFERENCE_PRICE=1
BOT_SPREAD_BPS=20
BOT_INVENTORY_TARGET=0.5
BOT_REBALANCE_THRESHOLD=0.1
BOT_MAX_POSITION=1
BOT_MAX_ORDERS=10
BOT_POLL_INTERVAL_MS=15000
BOT_MAX_UNCONFIRMED_BRANCH_DEPTH=24
BOT_ALLOW_MAINNET_BROADCAST=false
BOT_ENABLE_FILL_TRADING=true
BOT_ALLOW_SELF_FILLS=false
BOT_SIMULATE_OWN_FILLS=false
BOT_SIMULATION_TRADE_TIMEOUT_MS=60000

# Set in the shell at build time if using a separately supplied CommonJS Node WASM build.
# BOT_NODE_WASM_DIR=/absolute/path/to/pkg-node
